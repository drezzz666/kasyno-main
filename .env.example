# App URL (reverse proxy origin)
APP_URL=https://drezzz.tech
FRONTEND_PORT=8010

# Database Configuration
POSTGRES_USER=kasyno
POSTGRES_PASSWORD=kasyno_pass
POSTGRES_DB=kasyno
DATABASE_URL=postgres://kasyno:kasyno_pass@postgres:5432/kasyno?sslmode=disable

# Security / Session (at least 32 characters)
SESSION_SECRET=kasyno-2fgt-secret-key-replace-in-env-production-32-chars

# Authentik OIDC SSO
AUTHENTIK_ISSUER=https://login.2fgt.pl/application/o/kasyno/
AUTHENTIK_CLIENT_ID=your-client-id
AUTHENTIK_CLIENT_SECRET=your-client-secret

# Dev Auth Mode (set to true to enable /api/auth/dev-login?email=... for local testing)
DEV_AUTH_ENABLED=false

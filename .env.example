# =============================================================================
#              2FGT KASYNO - PRZYKŁADOWY PLIK KONFIGURACYJNY (.env.example)
# =============================================================================
# Skopiuj ten plik do .env i uzupełnij własne wartości:
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APLIKACJA I DOMENA (Reverse Proxy & Porty)
# -----------------------------------------------------------------------------
# Główny publiczny adres URL kasyna (używany do callbacków OIDC i Origin CSRF)
APP_URL=https://kasyno.twojadomena.pl

# Port lokalny na hoście dla kontenera Nginx (Frontend)
FRONTEND_PORT=8010

# Port wewnętrzny backendu Go (wewnątrz sieci dockerowej)
PORT=8080


# -----------------------------------------------------------------------------
# 2. BAZA DANYCH POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_USER=kasyno
POSTGRES_PASSWORD=twoje_bezpieczne_haslo_db
POSTGRES_DB=kasyno
POSTGRES_PORT=5434

# Connection String dla backendu Go do połączenia z kontenerem bazy danych
DATABASE_URL=postgres://kasyno:twoje_bezpieczne_haslo_db@postgres:5432/kasyno?sslmode=disable


# -----------------------------------------------------------------------------
# 3. BEZPIECZEŃSTWO I SESJE
# -----------------------------------------------------------------------------
# Klucz szyfrowania i podpisywania ciasteczek sesyjnych HMAC-SHA256 (min. 32 losowe znaki)
SESSION_SECRET=zmien-na-losowy-tajny-klucz-min-32-znaki-w-produkcji


# -----------------------------------------------------------------------------
# 4. INTEGRACJA AUTHENTIK SSO (OpenID Connect / OAuth2)
# -----------------------------------------------------------------------------
# Adres URL aplikacji w Authentik (Provider OIDC)
AUTHENTIK_ISSUER=https://auth.twojadomena.pl/application/o/kasyno/

# Client ID aplikacji z panelu Authentik
AUTHENTIK_CLIENT_ID=twoj_authentik_client_id

# Client Secret aplikacji z panelu Authentik
AUTHENTIK_CLIENT_SECRET=twoj_authentik_client_secret

# Opcjonalne manualne nadpisanie endpointów OIDC (domyślnie pobierane z discovery)
AUTHENTIK_AUTH_URL=
AUTHENTIK_TOKEN_URL=
AUTHENTIK_USERINFO_URL=
AUTHENTIK_END_SESSION_URL=


# -----------------------------------------------------------------------------
# 5. USTAWIENIA ROZGRYWKI I EKONOMII
# -----------------------------------------------------------------------------
# Logowanie deweloperskie bez Authentika (/api/auth/dev-login) - Ustaw false na produkcji
DEV_AUTH_ENABLED=false

# Początkowy stan konta nowego gracza ($FGT)
DEFAULT_BALANCE=1000

# Domyślna liczba gier do ukończenia misji
DAILY_MISSION_TARGET=5

# Domyślna nagroda w żetonach $FGT za ukończenie misji
DAILY_MISSION_REWARD=250


# -----------------------------------------------------------------------------
# 6. POWIADOMIENIA I MONITORING BŁĘDÓW (Discord Webhooks)
# -----------------------------------------------------------------------------
# Webhook Discorda do natychmiastowego wysyłania ogólnych raportów błędów (paniki, 500, błędy JS)
DISCORD_ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/TWOJ_ID/TWOJ_TOKEN

# Osobny webhook Discorda dedykowany dla alertów bezpieczeństwa i anticheata (boty, rate-limity, manipulacje)
DISCORD_SECURITY_WEBHOOK_URL=https://discord.com/api/webhooks/TWOJ_ID/TWOJ_TOKEN


# -----------------------------------------------------------------------------
# 7. BOT DISCORD (Zarządzanie kasynem i komendy graczy)
# -----------------------------------------------------------------------------
# Token bota Discord pobrany z Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Opcjonalne ID serwera (Guild ID) dla natychmiastowej rejestracji Slash Commands
DISCORD_GUILD_ID=

# Nazwa roli lub ID roli z uprawnieniami administratora w bocie (np. Admin, Właściciel)
DISCORD_ADMIN_ROLE=Admin

# Lista ID użytkowników Discorda z pełnymi uprawnieniami administratora (oddzielone przecinkami)
DISCORD_ADMIN_USER_IDS=


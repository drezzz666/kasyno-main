#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"

# Allocate pseudo-TTY only if stdin and stdout are a terminal
DOCKER_FLAGS=""
if [ -t 0 ] && [ -t 1 ]; then
  DOCKER_FLAGS="-it"
fi

if docker ps --format '{{.Names}}' | grep -q "^kasyno_2fgt$"; then
  exec docker exec $DOCKER_FLAGS kasyno_2fgt node scripts/admin.js "$@"
else
  exec docker compose exec $DOCKER_FLAGS kasyno node scripts/admin.js "$@"
fi
